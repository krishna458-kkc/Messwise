# ==============================================================================
# MessWise Backend Environment Variables Configuration Template
# ==============================================================================

# Server Port (provided automatically by Render in production)
PORT=8000
HOST=0.0.0.0

# Database Configuration Strategy:
# Option 1: Managed PostgreSQL (Recommended for production persistence on Render/Supabase/Neon)
# DATABASE_URL=postgresql://messwise:secretpassword@dpg-xxxxx.singapore-postgres.render.com/messwise_db

# Option 2: Local or Persistent Disk SQLite (Default fallback)
# MESSWISE_DB_PATH=data/messwise.db

# CORS Configuration:
# Allow deployed Vercel frontend origin(s) - comma separated
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-messwise-frontend.vercel.app

# Vercel Preview & Production regex match (automatically covers all *.vercel.app deployments)
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# Application Environment
ENVIRONMENT=production

# Automatic Synthetic Demonstration Data Seeding:
# Set to 'false' in production if starting a clean pilot mess with 0 records.
# Defaults to 'true' for local development & demonstration environments.
AUTO_SEED_SYNTHETIC=true
